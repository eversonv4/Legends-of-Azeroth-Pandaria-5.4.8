# Copie para ".env" e ajuste se quiser.
# Senha do usuario root do MySQL, usada pelo container "db" e pelos servidores.
DB_PASS=azerothcore

# Pasta da instalacao do client WoW 5.4.8 (precisa existir CLIENT_DIR/Data/...), usada pelo
# servico "tools" para extrair maps/vmaps/mmaps. Se nao definir, usa ./docker/client.
# Windows: use barras normais, ex. CLIENT_DIR=C:/Games/World of Warcraft 5.4.8
# CLIENT_DIR=G:/World of Warcraft 5.4.8
CLIENT_DIR=./docker/client
